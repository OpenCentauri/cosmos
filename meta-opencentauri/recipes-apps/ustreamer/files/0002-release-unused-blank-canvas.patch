Subject: [PATCH] stream: release blank RGB canvas for JPEG-only output

Keep the compressed blank JPEG, but release its RGB canvas when neither
raw nor H.264 output is configured. At 864x480 this removes a retained
1,244,160-byte allocation from the JPEG-only streaming configuration.

Check configured sink pointers at runtime, regardless of client activity,
and retain the canvas for raw and H.264 sinks. If a canvas was released
before options were parsed, the post-parse blank update redraws it.

Require valid pixel data before reusing the frametext cache, so subsequent
blank updates can regenerate the canvas after it has been released.

Upstream-Status: Pending
Base-Commit: 88460b72e191035d04355e25106af817cbfe069e
---
 src/libs/frametext.c   |  1 +
 src/ustreamer/stream.c | 13 +++++++++++++
 2 files changed, 14 insertions(+)

diff --git a/src/libs/frametext.c b/src/libs/frametext.c
index d5adfc73765558dd3f7e0b5052dec9c4678b1041..9daa61f02666a588c3d63378aeede9d1faee6393 100644
--- a/src/libs/frametext.c
+++ b/src/libs/frametext.c
@@ -92,6 +92,7 @@ void us_frametext_draw(us_frametext_s *ft, const char *text, uint width, uint he
 	if (
 		frame->width == width && frame->height == height
 		&& ft->text != NULL && !strcmp(ft->text, text)
+		&& frame->data != NULL && frame->used > 0
 	) {
 		return;
 	}
diff --git a/src/ustreamer/stream.c b/src/ustreamer/stream.c
index 9ae94e42b35d355df43d449a595810eefb06d501..497f97aaa33771efbc6d17e9de2baebc8cb56772 100644
--- a/src/ustreamer/stream.c
+++ b/src/ustreamer/stream.c
@@ -88,6 +88,7 @@ static bool _stream_has_jpeg_clients_cached(us_stream_s *stream);
 static bool _stream_has_any_clients_cached(us_stream_s *stream);
 static int _stream_init_loop(us_stream_s *stream);
 static void _stream_update_captured_fpsi(us_stream_s *stream, const us_frame_s *frame, bool bump);
+static void _stream_release_blank_raw(us_stream_s *stream);
 #ifdef WITH_V4P
 static void _stream_drm_ensure_no_signal(us_stream_s *stream);
 #endif
@@ -134,6 +135,7 @@ void us_stream_update_blank(us_stream_s *stream, const us_capture_s *cap) {
 	us_blank_draw(run->blank, "< NO LIVE VIDEO >", cap->width, cap->height);
 	us_fpsi_frame_to_meta(run->blank->raw, &run->notify_meta); // Initial "unchanged" meta
 	_stream_update_captured_fpsi(stream, run->blank->raw, false);
+	_stream_release_blank_raw(stream);
 }
 
 void us_stream_destroy(us_stream_s *stream) {
@@ -664,6 +666,7 @@ static int _stream_init_loop(us_stream_s *stream) {
 				_stream_expose_jpeg(stream, run->blank->jpeg);
 				_stream_expose_raw(stream, run->blank->raw);
 				_stream_encode_expose_h264(stream, run->blank->raw, true);
+				_stream_release_blank_raw(stream);
 
 #				ifdef WITH_V4P
 				_stream_drm_ensure_no_signal(stream);
@@ -675,6 +678,16 @@ static int _stream_init_loop(us_stream_s *stream) {
 	return -1;
 }
 
+static void _stream_release_blank_raw(us_stream_s *stream) {
+	// HTTP uses the compressed JPEG; raw and H.264 sinks still need the pixels.
+	if (stream->raw_sink == NULL && stream->h264_sink == NULL) {
+		us_frame_s *const raw = stream->run->blank->raw;
+		US_DELETE(raw->data, free);
+		raw->used = 0;
+		raw->allocated = 0;
+	}
+}
+
 static void _stream_update_captured_fpsi(us_stream_s *stream, const us_frame_s *frame, bool bump) {
 	us_stream_runtime_s *const run = stream->run;
 

#!/bin/sh
### BEGIN INIT INFO
# Provides:          klipper-firmware-dsp
# Required-Start:    $local_fs $remote_fs $network
# Required-Stop:     $local_fs $remote_fs $network
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: Start OpenCentauri firmware
### END INIT INFO

REMOTEPROCFILE="/sys/class/remoteproc/remoteproc0/state"

case "$1" in
    start)
        echo "Starting klipper-firmware-dsp..."
        echo start > $REMOTEPROCFILE
        ;;
    stop)
        echo "Stopping klipper-firmware-dsp..."
        echo stop > $REMOTEPROCFILE

        gpioset --chip gpiochip0 --toggle 0 205=0 # heated bed PG13
        gpioset --chip gpiochip0 --toggle 0 138=1 # stepper x enable PE10, active low
        gpioset --chip gpiochip0 --toggle 0 143=1 # stepper y enable PE15, active low
        gpioset --chip gpiochip0 --toggle 0 193=1 # stepper z enable PG1, active low
        gpioset --chip gpiochip0 --toggle 0 197=0 # buzzer PG5
        gpioset --chip gpiochip0 --toggle 0 208=0 # mainboard fan PG16
        gpioset --chip gpiochip0 --toggle 0 209=0 # aux fan PG17
        gpioset --chip gpiochip0 --toggle 0 210=0 # case fan PG18
        gpioset --chip gpiochip0 --toggle 0 207=0 # case led PG15
        ;;
    restart|force-reload)
        $0 stop
        sleep 1
        $0 start
        ;;
    status)
        echo "klipper-firmware-dsp is $(cat $REMOTEPROCFILE)"
        ;;
    *)
        echo "Usage: $0 {start|stop|restart|status}"
        exit 1
        ;;
esac

exit 0

#!/bin/sh
### BEGIN INIT INFO
# Provides:          klipper-firmware-dsp
# Required-Start:    $local_fs $remote_fs $network
# Required-Stop:     $local_fs $remote_fs $network
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: Start OpenCentauri firmware
### END INIT INFO

REMOTEPROCFILE="/sys/class/remoteproc/remoteproc0/state"

case "$1" in
    start)
        echo "Starting klipper-firmware-dsp..."
        echo start > $REMOTEPROCFILE
        ;;
    stop)
        echo "Stopping klipper-firmware-dsp..."
        echo stop > $REMOTEPROCFILE

        PINS=""
        PINS="$PINS 205=0" # heated bed PG13
        PINS="$PINS 166=1" # stepper x enable PF6, active low
        PINS="$PINS 143=1" # stepper y enable PE15, active low
        PINS="$PINS 140=1" # stepper z enable PE12, active low
        PINS="$PINS 44=0"  # buzzer PB12
        PINS="$PINS 207=0" # mainboard fan PG15
        PINS="$PINS 111=0" # aux fan PD15
        PINS="$PINS 113=0" # case fan PD17
        PINS="$PINS 37=0"  # case led PB5
        PINS="$PINS 39=0"  # case servo PB7
        gpioset --chip gpiochip0 --toggle 0 $PINS
        ;;
    restart|force-reload)
        $0 stop
        sleep 1
        $0 start
        ;;
    status)
        echo "klipper-firmware-dsp is $(cat $REMOTEPROCFILE)"
        ;;
    *)
        echo "Usage: $0 {start|stop|restart|status}"
        exit 1
        ;;
esac

exit 0

#!/bin/sh
### BEGIN INIT INFO
# Provides:          klipper-firmware-dsp
# Required-Start:    $local_fs $remote_fs $network
# Required-Stop:     $local_fs $remote_fs $network
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: Start OpenCentauri firmware
### END INIT INFO

REMOTEPROCFILE="/sys/class/remoteproc/remoteproc0/state"

set_gpio(){
    GPIO="$1"
    STATE="$2"

    echo $GPIO > /sys/class/gpio/export
    echo $STATE > /sys/class/gpio/gpio$GPIO/direction
    echo $GPIO > /sys/class/gpio/unexport
}

case "$1" in
    start)
        echo "Starting klipper-firmware-dsp..."
        echo start > $REMOTEPROCFILE
        ;;
    stop)
        echo "Stopping klipper-firmware-dsp..."
        echo stop > $REMOTEPROCFILE

        set_gpio 205 low  # heated bed PG13
        set_gpio 166 high # stepper x enable PF6, active low
        set_gpio 143 high # stepper y enable PE15, active low
        set_gpio 140 high # stepper z enable PE12, active low
        set_gpio 44  low  # buzzer PB12
        set_gpio 207 low  # mainboard fan PG15
        set_gpio 111 low  # aux fan PD15
        set_gpio 113 low  # case fan PD17
        set_gpio 37  low  # case led PB5
        set_gpio 39  low  # case servo PB7
        ;;
    restart|force-reload)
        $0 stop
        sleep 1
        $0 start
        ;;
    status)
        echo "klipper-firmware-dsp is $(cat $REMOTEPROCFILE)"
        ;;
    *)
        echo "Usage: $0 {start|stop|restart|status}"
        exit 1
        ;;
esac

exit 0

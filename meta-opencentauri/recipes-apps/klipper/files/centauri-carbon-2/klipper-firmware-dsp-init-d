#!/bin/sh
### BEGIN INIT INFO
# Provides:          klipper-firmware-dsp
# Required-Start:    $local_fs $remote_fs $network
# Required-Stop:     $local_fs $remote_fs $network
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: Start OpenCentauri firmware
### END INIT INFO

REMOTEPROCFILE="/sys/class/remoteproc/remoteproc0/state"

case "$1" in
    start)
        echo "Starting klipper-firmware-dsp..."
        echo start > $REMOTEPROCFILE
        ;;
    stop)
        echo "Stopping klipper-firmware-dsp..."
        echo stop > $REMOTEPROCFILE

        gpioset --chip gpiochip0 --toggle 0 205=0 # heated bed PG13
        gpioset --chip gpiochip0 --toggle 0 166=1 # stepper x enable PF6, active low
        gpioset --chip gpiochip0 --toggle 0 143=1 # stepper y enable PE15, active low
        gpioset --chip gpiochip0 --toggle 0 140=1 # stepper z enable PE12, active low
        gpioset --chip gpiochip0 --toggle 0 44=0  # buzzer PB12
        gpioset --chip gpiochip0 --toggle 0 207=0 # mainboard fan PG15
        gpioset --chip gpiochip0 --toggle 0 111=0 # aux fan PD15
        gpioset --chip gpiochip0 --toggle 0 113=0 # case fan PD17
        gpioset --chip gpiochip0 --toggle 0 37=0  # case led PB5
        gpioset --chip gpiochip0 --toggle 0 39=0  # case servo PB7
        ;;
    restart|force-reload)
        $0 stop
        sleep 1
        $0 start
        ;;
    status)
        echo "klipper-firmware-dsp is $(cat $REMOTEPROCFILE)"
        ;;
    *)
        echo "Usage: $0 {start|stop|restart|status}"
        exit 1
        ;;
esac

exit 0

+typedef struct {
+    uint32_t    frequency_hz;   /* PWM frequency */
+    uint16_t    duty_percent;   /* Duty cycle 0-100 (or use duty_raw) */
+    bool        active_high;    /* Active high output */
+} pwm_config_t;

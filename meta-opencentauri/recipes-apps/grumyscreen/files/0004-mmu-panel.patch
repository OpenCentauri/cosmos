+#ifndef __MMU_PANEL_H__
+#define __MMU_PANEL_H__
+
+#include "websocket_client.h"
+#include "notify_consumer.h"
+#include "button_container.h"
+#include "lvgl/lvgl.h"
+
+#include <mutex>
+
+class MMUPanel : public NotifyConsumer {
+ public:
+  MMUPanel(KWebSocketClient &ws, std::mutex &lock);
+  ~MMUPanel();
+
+  void consume(json &j);
+  void foreground();
+  void handle_callback(lv_event_t *event);
+
+  static void _handle_callback(lv_event_t *event) {
+    MMUPanel *panel = (MMUPanel*)event->user_data;
+    panel->handle_callback(event);
+  }
+
+ private:
+  void update_status(json &mmu_status);
+
+  KWebSocketClient &ws;
+  lv_obj_t *mmu_cont;
+  lv_obj_t *status_label;
+  lv_obj_t *tool_label;
+  
+  ButtonContainer gate_btns[12];
+  ButtonContainer home_btn;
+  ButtonContainer eject_btn;
+  ButtonContainer recover_btn;
+  ButtonContainer bypass_btn;
+  ButtonContainer back_btn;
+  
+  int current_gate;
+  int num_gates;
+  bool mmu_enabled;
+};
+
+#endif // __MMU_PANEL_H__

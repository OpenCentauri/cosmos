+SYSV_INIT_PATH = "/etc/init.d"
+SYSV_PID_PATH = "/var/run"
+SYSV_ACTIONS = ("start", "stop", "restart")
+SYSV_ACTION_TIMEOUT = 60.
+SYSV_STATUS_TIMEOUT = 5.
+SYSV_STATUS_SEQUENCE = 5
 
 class Machine:
     def __init__(self, config: ConfigHelper) -> None:
@@ -112,6 +120,7 @@ class Machine:
             "none": BaseProvider,
             "systemd_cli": SystemdCliProvider,
             "systemd_dbus": SystemdDbusProvider,

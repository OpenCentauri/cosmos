swu_version=0.0.0
swu_mode=mainline
systemAB_next=A
boot_part=5
mmc_root=/dev/mmcblk0p7
setargs_mainline=setenv bootargs console=ttyS2,115200 root=${mmc_root} rootwait
bootcmd_mainline=run setargs_mainline; fatload mmc 1:${boot_part} 43000000 zImage; fatload mmc 1:${boot_part} 43800000 elegoo-centauri-carbon2.dtb; bootz 43000000 - 43800000
bootcmd=if test x${swu_mode} = xmainline; then run bootcmd_mainline; else run bootcmd_stock; fi

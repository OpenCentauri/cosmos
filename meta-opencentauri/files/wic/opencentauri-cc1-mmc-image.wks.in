# short-description: Create MMC image for Elegoo Centauri Carbon 2
# long-description:
# Image for the Elegoo Centauri Carbon 1 (Allwinner R528) that reproduces the
# stock eMMC partition layout.
#
# GPT partition names match stock so /dev/by-name/* resolves the same as on
# Elegoo firmware (stock tools and the stock-swu rollback path use by-name).

part u-boot          --source rawcopy           --ondisk mmcblk0 --sourceparams="file=${SPL_BINARY}"           --no-table                                                         --align 8
part /boot-resource  --source rootfs            --ondisk mmcblk0 --fstype=vfat     --label bootlogos           --part-name boot-resource   --fixed-size 6300k    --offset 20732k  --align 1 --rootfs-dir=${IMAGE_ROOTFS}/boot-resource
part                 --source rawcopy           --ondisk mmcblk0 --sourceparams="file=u-boot-initial-env-emmc" --part-name env             --fixed-size 251k     --offset 27032k  --align 1
part                 --source rawcopy           --ondisk mmcblk0 --sourceparams="file=u-boot-initial-env-emmc" --part-name env-redund      --fixed-size 251k     --offset 27284k  --align 1
part                 --source bootimg-partition --ondisk mmcblk0 --fstype=vfat     --label bootA               --part-name bootA           --fixed-size 6299k    --offset 27536k  --align 1
part                 --source rootfs            --ondisk mmcblk0 --fstype=squashfs                             --part-name rootfsA         --fixed-size 131125k  --offset 33836k  --align 1
part                 --source empty             --ondisk mmcblk0 --fstype=ext4     --label dsp0A               --part-name dsp0A           --fixed-size 1007k    --offset 165002k --align 1
part                 --source bootimg-partition --ondisk mmcblk0 --fstype=vfat     --label bootB               --part-name bootB           --fixed-size 6299k    --offset 166010k --align 1
part                 --source rootfs            --ondisk mmcblk0 --fstype=squashfs                             --part-name rootfsB         --fixed-size 131125k  --offset 172310k --align 1
part                 --source empty             --ondisk mmcblk0 --fstype=ext4     --label dsp0B               --part-name dsp0B           --fixed-size 1007k    --offset 303476k --align 1
part                 --source empty             --ondisk mmcblk0 --fstype=ext4     --label rootfs_data         --part-name rootfs_data     --fixed-size 131125k  --offset 304484k --align 1
part /board-resource --source empty             --ondisk mmcblk0 --fstype=ext4     --label user                --part-name user            --fixed-size 131125k  --offset 435650k --align 1
part                 --source empty             --ondisk mmcblk0 --fstype=ext4     --label private             --part-name private         --fixed-size 1007k    --offset 566816k --align 1
part /user-resource  --source empty             --ondisk mmcblk0 --fstype=ext4     --label UDISK               --part-name UDISK           --fixed-size 6903263k --offset 567824k --align 1
bootloader --ptable gpt

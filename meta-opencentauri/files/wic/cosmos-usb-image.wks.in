# short-description: Create USB stick image with a boot partition
# long-description:
# Create an image that can be written onto a USB stick using dd for use
# with Allwinner arm (32-bit) SoC family
#
# The disk layout used is:
#  - --------------------------- -------------- --------------
# | | u-boot-sunxi-with-spl.bin |     boot     |    rootfs    |
#  - --------------------------- -------------- --------------
# ^ ^                           ^              ^              ^
# | |                           |              |              |
# 0 |                         2MiB  ${SUNXI_BOOT_SPACE}MiB  ${SUNXI_BOOT_SPACE}MiB + rootfs + IMAGE_EXTRA_SPACE
#   8KiB 
#

# Boots from the USB u-boot variant (u-boot-cc2-usb.config), not the
# eMMC SPL that ${SPL_BINARY} resolves to.
part u-boot --source rawcopy --sourceparams="file=u-boot-sunxi-with-spl.bin-usb" --ondisk sda --no-table --align 8
part /boot --source bootimg-partition --ondisk sda --fstype=vfat --label boot --active --align 2048 --fixed-size ${SUNXI_BOOT_SPACE}
part /     --source rootfs --ondisk sda --fstype=ext4 --align 2048

#!/bin/sh
### BEGIN INIT INFO
# Provides:          centauri-carbon-2-detect
# Required-Start:    $local_fs $remote_fs
# Required-Stop:
# X-Start-Before:     klipper-firmware-bed klipper-firmware-toolhead klipper-firmware-dsp klipper-firmware-canvas klipper
# Default-Start:     2 3 4 5
# Default-Stop:
# Short-Description: Detect Centauri Carbon 2 hardware on first boot
### END INIT INFO

set -e

# /etc is persistent across firmware updates and cleared by a factory reset.
MARKER="/etc/centauri-carbon-2-detected"
SERIALPORT="/dev/ttyS1"
GPIO="117"

case "$1" in
    start)
        [ ! -f "$MARKER" ] || exit 0

        echo "Detecting Centauri Carbon 2 hardware..."
        enclosed=False
        [ ! -e /dev/video0 ] || enclosed=True

        # Match the CANVAS init service's power-on sequence.
        echo "$GPIO" > /sys/class/gpio/export
        echo out > "/sys/class/gpio/gpio$GPIO/direction"
        echo 1 > "/sys/class/gpio/gpio$GPIO/value"
        echo "$GPIO" > /sys/class/gpio/unexport
        sleep 0.2

        hardware="$("@LIBEXECDIR@/probe-canvas" "$SERIALPORT")"

        # Leave the port powered off before the firmware services start.
        echo "$GPIO" > /sys/class/gpio/export
        echo out > "/sys/class/gpio/gpio$GPIO/direction"
        echo 0 > "/sys/class/gpio/gpio$GPIO/value"
        echo "$GPIO" > /sys/class/gpio/unexport
        sleep 0.5

        canvas=False
        [ "$hardware" != canvas ] || canvas=True

        config-manager extras enclosed "$enclosed" > /dev/null
        config-manager extras elegoo_canvas "$canvas" > /dev/null
        echo "Detected enclosed=$enclosed, elegoo_canvas=$canvas ($hardware)."
        touch "$MARKER"
        ;;
    stop)
        ;;
    *)
        echo "Usage: $0 {start|stop}"
        exit 1
        ;;
esac

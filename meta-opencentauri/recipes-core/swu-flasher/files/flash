#!/bin/sh

if [ ! -f "$1" ]; then
    echo "Usage: $0 path/to/update.swu [cosmos|stable]"
    exit 1
fi

if [ -n "$2" ]; then
    selection="$2"
else
    selection="cosmos"
fi

curr=$(fw_printenv systemAB_next | awk -F= '{ print $2 }' | tr -d '[:space:]')

if [[ "$curr" == "A" ]]; then
    boot_partition="now_A_next_B"
elif [[ "$curr" == "B" ]]; then
    boot_partition="now_B_next_A"
else
    exit 1
fi

echo "$boot_partition"

set -e
readonly-config-reset
swupdate -v -i "$1" -e ${selection},${boot_partition}
sync
echo "Update finished, run 'reboot' to finalize"

#!/bin/sh

set -e

machine_type="$(fw_printenv -n machine_type 2>/dev/null)" || machine_type=""
case "$machine_type" in
    centauri-carbon-2) ENCLOSED=True ;;
    centauri-2) ENCLOSED=False ;;
    *)
        ENCLOSED="$(config-manager extras enclosed 2>/dev/null)"
        ;;
esac

if [ "$ENCLOSED" = "True" ]; then
    FW_URL="https://github.com/OpenCentauri/OpenCentauri/releases/download/v0.0.0/cc2_eeb001_01.03.02.51_20260421171758.swu"
else
    FW_URL="https://github.com/OpenCentauri/OpenCentauri/releases/download/v0.0.0/c2_eeb001_02.01.01.04_20260826185114.swu"
fi

SWUFILE="/user-resource/update.swu"

# Download firmware
curl -k -f -S -o "$SWUFILE" -L "$FW_URL"

# Check file exists and is not empty, clean up and exit if not
if [ ! -s "$SWUFILE" ]; then
    echo "Failed to download update.swu - Aborting."
    rm -f "$SWUFILE"
    exit 1
fi

# Install firmware
flash "$SWUFILE"

# Clean up firmware file
rm "$SWUFILE"

sleep 3

reboot

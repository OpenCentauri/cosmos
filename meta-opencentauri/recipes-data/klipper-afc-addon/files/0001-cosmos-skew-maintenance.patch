+    def _cosmos_skew_suspend(self):
+        # Stack-local ownership: nested operations/callbacks see enabled=False.
+        # Never restore in finally: an error must leave correction suspended.
+        state = dict(self.printer.lookup_object(
+            'gcode_macro LOAD_SKEW_IF_EXISTS').get_status(self.reactor.monotonic()))
+        self.gcode.run_script_from_command('_SKEW_SUSPEND')
+        return state
+
+    def _cosmos_skew_restore(self, state, resuming=False):
+        if self.error_state:
+            return
+        if resuming:
+            # RESUME_BASE only schedules virtual-SD work: print_stats may still
+            # say paused until note_start runs. Restore the profile already
+            # authorized by COSMOS RESUME, without weakening ordinary tails.
+            eventtime = self.reactor.monotonic()
+            current = self.printer.lookup_object(
+                'gcode_macro LOAD_SKEW_IF_EXISTS').get_status(eventtime)
+            print_state = self.printer.lookup_object('print_stats').get_status(eventtime)['state']
+            if (state['enabled'] and current['generation'] == state['generation']
+                and current['phase'] == 'printing' and not self.function.is_paused()
+                and print_state in ('printing', 'paused')):
+                self.gcode.run_script_from_command('LOAD_SKEW_IF_EXISTS')
+        else:
+            self.gcode.run_script_from_command(
+                '_RESTORE_SKEW_AFTER_MAINTENANCE RESTORE={} GENERATION={}'.format(
+                    state['enabled'], state['generation']))
+
     def TOOL_UNLOAD(self, cur_lane: AFCLane, set_start_time=True, force_unload=False):
+        state = self._cosmos_skew_suspend()
+        success = self._TOOL_UNLOAD(cur_lane, set_start_time, force_unload)
+        if success:
+            self._cosmos_skew_restore(state)
+        return success

From 056d75895952fd65d49eedb9f91b15b269235c83 Mon Sep 17 00:00:00 2001
From: 0xD34DC0DE <emerickpoulin31415@gmail.com>
Date: Thu, 19 Nov 2026 11:58:19 -0500
Subject: [PATCH 1/2] mmc: core: add optional DDR52 sample point tuning hooks

eMMC DDR52 has no tuning command, so hosts that need a sample point
for it cannot tune it through execute_tuning(). Add two optional host
operations around the switch to DDR52 in mmc_select_hs_ddr():
prepare_hs_ddr_tuning() in HS mode right before the switch, and
execute_hs_ddr_tuning() right after it.

A host returns -EOPNOTSUPP from prepare_hs_ddr_tuning() when it does
not tune. Any other error, or a failed execute_hs_ddr_tuning(), keeps
or puts the card back in HS mode: DDR52 without a working sample point
is worse than HS.

Upstream-Status: Inappropriate [CoSMOS specific, needed by the sunxi-mmc DDR52 tuning]
---
 drivers/mmc/core/mmc.c   | 34 ++++++++++++++++++++++++++++++++--
 include/linux/mmc/host.h |  9 +++++++++
 2 files changed, 41 insertions(+), 2 deletions(-)

diff --git a/drivers/mmc/core/mmc.c b/drivers/mmc/core/mmc.c
index 05444ecf3..94d07d4da 100644
--- a/drivers/mmc/core/mmc.c
+++ b/drivers/mmc/core/mmc.c
@@ -1112,6 +1112,7 @@ static int mmc_select_hs_ddr(struct mmc_card *card)
 {
 	struct mmc_host *host = card->host;
 	u32 bus_width, ext_csd_bits;
+	bool tune = false;
 	int err = 0;
 
 	if (!(card->mmc_avail_type & EXT_CSD_CARD_TYPE_DDR_52))
@@ -1124,6 +1125,17 @@ static int mmc_select_hs_ddr(struct mmc_card *card)
 	ext_csd_bits = (bus_width == MMC_BUS_WIDTH_8) ?
 		EXT_CSD_DDR_BUS_WIDTH_8 : EXT_CSD_DDR_BUS_WIDTH_4;
 
+	if (host->ops->prepare_hs_ddr_tuning &&
+	    host->ops->execute_hs_ddr_tuning) {
+		err = host->ops->prepare_hs_ddr_tuning(host, card);
+		if (err && err != -EOPNOTSUPP) {
+			pr_warn("%s: cannot tune DDR52 (%d), staying in HS mode\n",
+				mmc_hostname(host), err);
+			return 0;
+		}
+		tune = !err;
+	}
+
 	err = __mmc_switch(card, EXT_CSD_CMD_SET_NORMAL,
 			   EXT_CSD_BUS_WIDTH,
 			   ext_csd_bits,
@@ -1164,7 +1176,7 @@ static int mmc_select_hs_ddr(struct mmc_card *card)
 	if (card->mmc_avail_type & EXT_CSD_CARD_TYPE_DDR_1_2V) {
 		err = mmc_set_signal_voltage(host, MMC_SIGNAL_VOLTAGE_120);
 		if (!err)
-			return 0;
+			goto tuning;
 	}
 
 	if (card->mmc_avail_type & EXT_CSD_CARD_TYPE_DDR_1_8V &&
@@ -1174,8 +1186,26 @@ static int mmc_select_hs_ddr(struct mmc_card *card)
 	/* make sure vccq is 3.3v after switching disaster */
 	if (err)
 		err = mmc_set_signal_voltage(host, MMC_SIGNAL_VOLTAGE_330);
+	if (err)
+		return err;
 
-	return err;
+tuning:
+	if (!tune)
+		return 0;
+
+	err = host->ops->execute_hs_ddr_tuning(host, card);
+	if (!err)
+		return 0;
+
+	/* DDR52 without a working sample point is worse than HS */
+	pr_warn("%s: DDR52 tuning failed (%d), switching back to HS mode\n",
+		mmc_hostname(host), err);
+
+	return __mmc_switch(card, EXT_CSD_CMD_SET_NORMAL, EXT_CSD_BUS_WIDTH,
+			    bus_width == MMC_BUS_WIDTH_8 ?
+			    EXT_CSD_BUS_WIDTH_8 : EXT_CSD_BUS_WIDTH_4,
+			    card->ext_csd.generic_cmd6_time, MMC_TIMING_MMC_HS,
+			    true, true, MMC_CMD_RETRIES);
 }
 
 static int mmc_select_hs400(struct mmc_card *card)
diff --git a/include/linux/mmc/host.h b/include/linux/mmc/host.h
index ba84f02c2..104f145ad 100644
--- a/include/linux/mmc/host.h
+++ b/include/linux/mmc/host.h
@@ -230,6 +230,15 @@ struct mmc_host_ops {
 	/* Execute HS400 tuning depending host driver */
 	int	(*execute_hs400_tuning)(struct mmc_host *host, struct mmc_card *card);
 
+	/*
+	 * Optional sample point tuning for eMMC DDR52, which has no tuning
+	 * command. prepare_hs_ddr_tuning() is called in HS mode right before
+	 * the switch to DDR52 and execute_hs_ddr_tuning() right after it.
+	 * The latter is only called if the former returned 0.
+	 */
+	int	(*prepare_hs_ddr_tuning)(struct mmc_host *host, struct mmc_card *card);
+	int	(*execute_hs_ddr_tuning)(struct mmc_host *host, struct mmc_card *card);
+
 	/* Optional callback to prepare for SD high-speed tuning */
 	int	(*prepare_sd_hs_tuning)(struct mmc_host *host, struct mmc_card *card);
 

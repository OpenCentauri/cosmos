From f6560e29f0fa7f590d1ffdd20a5fc99fa28348ea Mon Sep 17 00:00:00 2001
From: 0xD34DC0DE <emerickpoulin31415@gmail.com>
Date: Thu, 19 Nov 2026 13:01:14 -0500
Subject: [PATCH 2/2] mmc: sunxi: add DT options for a stock-like, tuned DDR52
 setup

Some Elegoo Centauri 2 boards use an eMMC ("MMC8GB", manufacturer 0x32,
OEM 0x0101, firmware 0x01) that fails DDR52 writes with CRC status
errors in the mainline setup, while the Allwinner BSP runs it at DDR52
without errors. Add device tree options, all off by default, to
reproduce the BSP setup:

- allwinner,ddr-old-timing: run DDR52 in the old timing mode, with the
  module clock at twice the card clock (card clock capped at 50 MHz)
  and the internal divider bypassed
- allwinner,ddr52-tuning: tune the DDR52 sample delay like the BSP
  boot loader, but read-only: read 30 KiB from LBA 0 in HS mode, then
  for every delay read it 15 times in DDR52 and compare. Use the centre
  of the widest passing window (at least 8 delays) and check it with
  3 more reads. The controller is reset after every failed read, as
  the BSP does after data errors. A re-initialisation only checks the
  delay found before. Without a usable window the card stays in HS.
  The module parameter sunxi_mmc.ddr52_tuning_force_fail=1 forces
  this HS fallback, to test it or to work around a bad tuning result.
- allwinner,sample-delay: fixed DDR52 sample delay (0..63), skips the
  tuning
- allwinner,fifo-watermark: FTRGL value instead of 0x20070008
- allwinner,write-threshold: on writes, only start sending a block once
  it is fully in the FIFO (when it fits the TX trigger level)

Upstream-Status: Inappropriate [board specific workaround]
---
 drivers/mmc/host/sunxi-mmc.c | 409 ++++++++++++++++++++++++++++++++++-
 1 file changed, 400 insertions(+), 9 deletions(-)

diff --git a/drivers/mmc/host/sunxi-mmc.c b/drivers/mmc/host/sunxi-mmc.c
index fe4c0f6d7..050d8fd6f 100644
--- a/drivers/mmc/host/sunxi-mmc.c
+++ b/drivers/mmc/host/sunxi-mmc.c
@@ -9,6 +9,7 @@
  * (C) Copyright 2017 Sootech SA
  */
 
+#include <linux/bitfield.h>
 #include <linux/clk.h>
 #include <linux/clk/sunxi-ng.h>
 #include <linux/delay.h>
@@ -69,6 +70,7 @@
 /* New registers introduced in A64 */
 #define SDXC_REG_A12A		0x058 /* SMC Auto Command 12 Register */
 #define SDXC_REG_SD_NTSR	0x05C /* SMC New Timing Set Register */
+#define SDXC_REG_THLD		0x100 /* SMC Card Threshold Control Register */
 #define SDXC_REG_DRV_DL		0x140 /* Drive Delay Control Register */
 #define SDXC_REG_SAMP_DL_REG	0x144 /* SMC sample delay control */
 #define SDXC_REG_DS_DL_REG	0x148 /* SMC data strobe delay control */
@@ -228,6 +230,10 @@
 #define SDXC_CAL_DL_SW_SHIFT	0
 #define SDXC_CAL_DL_MASK	0x3f
 
+/* Card threshold control register (SDXC_REG_THLD) */
+#define SDXC_CARD_WR_THLD_EN	BIT(2)
+#define SDXC_CARD_THLD_MASK	GENMASK(27, 16)
+
 #define SDXC_CAL_TIMEOUT	3	/* in seconds, 3s is enough*/
 
 struct sunxi_mmc_clk_delay {
@@ -300,6 +306,20 @@ struct sunxi_mmc_host {
 
 	/* timings */
 	bool		use_new_timings;
+
+	/* optional board specific tweaks from the device tree */
+	bool		ddr_old_timing;
+	bool		write_threshold;
+	bool		sample_delay_fixed;
+	u32		sample_delay;
+	u32		fifo_watermark;
+
+	/* DDR52 sample delay tuning */
+	bool		ddr52_tuning;
+	bool		ddr52_tuned;	/* sample_delay holds a tuned delay */
+	bool		ddr_fallback;	/* tuning failed, until back in HS */
+	bool		tuning;		/* sweep running, errors are expected */
+	u8		*tuning_buf;
 };
 
 static int sunxi_mmc_reset_host(struct sunxi_mmc_host *host)
@@ -328,11 +348,12 @@ static int sunxi_mmc_init_host(struct sunxi_mmc_host *host)
 		return -EIO;
 
 	/*
-	 * Burst 8 transfers, RX trigger level: 7, TX trigger level: 8
+	 * FIFO trigger levels and DMA burst size, by default burst 8
+	 * transfers, RX trigger level: 7, TX trigger level: 8
 	 *
 	 * TODO: sun9i has a larger FIFO and supports higher trigger values
 	 */
-	mmc_writel(host, REG_FTRGL, 0x20070008);
+	mmc_writel(host, REG_FTRGL, host->fifo_watermark);
 	/* Maximum timeout value */
 	mmc_writel(host, REG_TMOUT, 0xffffffff);
 	/* Unmask SDIO interrupt if needed */
@@ -468,7 +489,8 @@ static void sunxi_mmc_send_manual_stop(struct sunxi_mmc_host *host,
 		 time_before(jiffies, expire));
 
 	if (!(ri & SDXC_COMMAND_DONE) || (ri & SDXC_INTERRUPT_ERROR_BIT)) {
-		dev_err(mmc_dev(host->mmc), "send stop command failed\n");
+		if (!host->tuning)
+			dev_err(mmc_dev(host->mmc), "send stop command failed\n");
 		if (req->stop)
 			req->stop->resp[0] = -ETIMEDOUT;
 	} else {
@@ -636,7 +658,8 @@ static irqreturn_t sunxi_mmc_handle_manual_stop(int irq, void *dev_id)
 		return IRQ_HANDLED;
 	}
 
-	dev_err(mmc_dev(host->mmc), "data error, sending stop command\n");
+	if (!host->tuning)
+		dev_err(mmc_dev(host->mmc), "data error, sending stop command\n");
 
 	/*
 	 * We will never have more than one outstanding request,
@@ -699,7 +722,8 @@ static int sunxi_mmc_oclk_onoff(struct sunxi_mmc_host *host, u32 oclk_en)
 	return 0;
 }
 
-static int sunxi_mmc_calibrate(struct sunxi_mmc_host *host, int reg_off)
+static int sunxi_mmc_calibrate(struct sunxi_mmc_host *host, int reg_off,
+			       u32 delay)
 {
 	if (!host->cfg->can_calibrate)
 		return 0;
@@ -713,7 +737,7 @@ static int sunxi_mmc_calibrate(struct sunxi_mmc_host *host, int reg_off)
 	 * The only mode that doesn't have such a delay is HS400, that
 	 * is in itself a TODO.
 	 */
-	writel(SDXC_CAL_DL_SW_EN, host->reg_base + reg_off);
+	writel(SDXC_CAL_DL_SW_EN | delay, host->reg_base + reg_off);
 
 	return 0;
 }
@@ -762,8 +786,19 @@ static int sunxi_mmc_clk_set_rate(struct sunxi_mmc_host *host,
 	struct mmc_host *mmc = host->mmc;
 	long rate;
 	u32 rval, clock = ios->clock, div = 1;
+	bool old_timing_ddr = host->ddr_old_timing && !host->ddr_fallback &&
+			      host->use_new_timings &&
+			      ios->timing == MMC_TIMING_MMC_DDR52;
 	int ret;
 
+	/*
+	 * In the old timing mode the module clock runs at twice the card
+	 * clock. Cap the card clock at 50 MHz so that the 100 MHz module
+	 * clock comes from pll-periph0 (600 MHz / 6) on the D1/R528.
+	 */
+	if (old_timing_ddr)
+		clock = min(clock, 50000000U);
+
 	ret = sunxi_mmc_oclk_onoff(host, 0);
 	if (ret)
 		return ret;
@@ -782,8 +817,14 @@ static int sunxi_mmc_clk_set_rate(struct sunxi_mmc_host *host,
 	 * We currently only support the standard MMC DDR52 mode.
 	 * This block should be updated once support for other DDR
 	 * modes is added.
+	 *
+	 * Boards with "allwinner,ddr-old-timing" run DDR52 in the old
+	 * timing mode instead, with the module clock at the requested
+	 * rate and no internal divider, as the Allwinner BSP does.
 	 */
-	if (ios->timing == MMC_TIMING_MMC_DDR52 &&
+	if (old_timing_ddr) {
+		/* module clock as requested, internal divider bypassed */
+	} else if (ios->timing == MMC_TIMING_MMC_DDR52 &&
 	    (host->use_new_timings ||
 	     ios->bus_width == MMC_BUS_WIDTH_8)) {
 		div = 2;
@@ -834,7 +875,10 @@ static int sunxi_mmc_clk_set_rate(struct sunxi_mmc_host *host,
 	if (host->use_new_timings) {
 		/* Don't touch the delay bits */
 		rval = mmc_readl(host, REG_SD_NTSR);
-		rval |= SDXC_2X_TIMING_MODE;
+		if (old_timing_ddr)
+			rval &= ~SDXC_2X_TIMING_MODE;
+		else
+			rval |= SDXC_2X_TIMING_MODE;
 		mmc_writel(host, REG_SD_NTSR, rval);
 	}
 
@@ -843,7 +887,8 @@ static int sunxi_mmc_clk_set_rate(struct sunxi_mmc_host *host,
 	if (ret)
 		return ret;
 
-	ret = sunxi_mmc_calibrate(host, SDXC_REG_SAMP_DL_REG);
+	ret = sunxi_mmc_calibrate(host, SDXC_REG_SAMP_DL_REG,
+				  old_timing_ddr ? host->sample_delay : 0);
 	if (ret)
 		return ret;
 
@@ -1005,6 +1050,24 @@ static void sunxi_mmc_hw_reset(struct mmc_host *mmc)
 	udelay(300);
 }
 
+/*
+ * Only start sending a write block once the whole block is in the FIFO,
+ * as the Allwinner BSP does. The block has to fit in the FIFO TX trigger
+ * level, otherwise the transfer never starts.
+ */
+static void sunxi_mmc_set_write_threshold(struct sunxi_mmc_host *host,
+					  struct mmc_data *data)
+{
+	u32 thld = mmc_readl(host, REG_THLD);
+
+	thld &= ~(SDXC_CARD_THLD_MASK | SDXC_CARD_WR_THLD_EN);
+	if ((data->flags & MMC_DATA_WRITE) &&
+	    data->blksz <= (host->fifo_watermark & 0xff) * 4)
+		thld |= FIELD_PREP(SDXC_CARD_THLD_MASK, data->blksz) |
+			SDXC_CARD_WR_THLD_EN;
+	mmc_writel(host, REG_THLD, thld);
+}
+
 static void sunxi_mmc_request(struct mmc_host *mmc, struct mmc_request *mrq)
 {
 	struct sunxi_mmc_host *host = mmc_priv(mmc);
@@ -1089,6 +1152,8 @@ static void sunxi_mmc_request(struct mmc_host *mmc, struct mmc_request *mrq)
 	if (data) {
 		mmc_writel(host, REG_BLKSZ, data->blksz);
 		mmc_writel(host, REG_BCNTR, data->blksz * data->blocks);
+		if (host->write_threshold)
+			sunxi_mmc_set_write_threshold(host, data);
 		sunxi_mmc_start_dma(host, data);
 	}
 
@@ -1108,6 +1173,311 @@ static int sunxi_mmc_card_busy(struct mmc_host *mmc)
 	return !!(mmc_readl(host, REG_STAS) & SDXC_CARD_DATA_BUSY);
 }
 
+/*
+ * DDR52 sample delay tuning, like the Allwinner BSP boot loader does it but
+ * without writing to the card: a reference is read in HS mode right before
+ * the switch to DDR52, then every sample delay is tested by reading the same
+ * blocks in DDR52 and comparing them with the reference. The centre of the
+ * widest window of passing delays is used. If there is no usable window, the
+ * default DDR52 setup (new timing mode) is used instead.
+ */
+#define SUNXI_TUNING_BLOCKS	60	/* from LBA 0: GPT and boot loader */
+#define SUNXI_TUNING_LEN	(SUNXI_TUNING_BLOCKS * 512)
+#define SUNXI_TUNING_SEG	SZ_4K	/* below every IDMA descriptor limit */
+#define SUNXI_TUNING_PASSES	15	/* reads per delay, all must match */
+#define SUNXI_TUNING_MIN_WINDOW	8	/* narrowest usable window */
+
+static bool ddr52_tuning_force_fail;
+module_param(ddr52_tuning_force_fail, bool, 0444);
+MODULE_PARM_DESC(ddr52_tuning_force_fail,
+		 "Fail the DDR52 tuning, so that the card stays in HS mode (for tests)");
+
+static int sunxi_mmc_tuning_read(struct mmc_host *mmc, struct mmc_card *card,
+				 u8 *buf)
+{
+	struct scatterlist sg[DIV_ROUND_UP(SUNXI_TUNING_LEN, SUNXI_TUNING_SEG)];
+	struct mmc_command cmd = {}, stop = {};
+	struct mmc_data data = {};
+	struct mmc_request mrq = {};
+	int i;
+
+	sg_init_table(sg, ARRAY_SIZE(sg));
+	for (i = 0; i < ARRAY_SIZE(sg); i++)
+		sg_set_buf(&sg[i], buf + i * SUNXI_TUNING_SEG,
+			   min(SUNXI_TUNING_SEG,
+			       SUNXI_TUNING_LEN - i * SUNXI_TUNING_SEG));
+
+	/* LBA 0: the argument is 0 for both byte and block addressing */
+	cmd.opcode = MMC_READ_MULTIPLE_BLOCK;
+	cmd.arg = 0;
+	cmd.flags = MMC_RSP_R1 | MMC_CMD_ADTC;
+
+	stop.opcode = MMC_STOP_TRANSMISSION;
+	stop.flags = MMC_RSP_R1B | MMC_CMD_AC;
+
+	data.blksz = 512;
+	data.blocks = SUNXI_TUNING_BLOCKS;
+	data.flags = MMC_DATA_READ;
+	data.sg = sg;
+	data.sg_len = ARRAY_SIZE(sg);
+	mmc_set_data_timeout(&data, card);
+
+	mrq.cmd = &cmd;
+	mrq.data = &data;
+	mrq.stop = &stop;
+
+	mmc_wait_for_req(mmc, &mrq);
+
+	return cmd.error ?: data.error ?: stop.error;
+}
+
+/* A read is a better test with varied data than with long 0x00/0xff runs */
+static bool sunxi_mmc_tuning_ref_ok(const u8 *buf)
+{
+	unsigned int i, flat = 0;
+
+	for (i = 0; i < SUNXI_TUNING_LEN; i++)
+		flat += buf[i] == 0x00 || buf[i] == 0xff;
+
+	return flat < SUNXI_TUNING_LEN / 10 * 9;
+}
+
+static int sunxi_mmc_set_sample_delay(struct sunxi_mmc_host *host, u32 delay)
+{
+	int ret;
+
+	ret = sunxi_mmc_oclk_onoff(host, 0);
+	if (ret)
+		return ret;
+
+	sunxi_mmc_calibrate(host, SDXC_REG_SAMP_DL_REG, delay);
+
+	return sunxi_mmc_oclk_onoff(host, 1);
+}
+
+/*
+ * After a failed transfer the controller does not complete the next clock
+ * update, so reset it and set it up again, as the Allwinner BSP does after
+ * every data error.
+ */
+static int sunxi_mmc_tuning_recover(struct sunxi_mmc_host *host)
+{
+	struct mmc_host *mmc = host->mmc;
+	int ret;
+
+	ret = sunxi_mmc_init_host(host);
+	if (ret)
+		return ret;
+
+	sunxi_mmc_set_bus_width(host, mmc->ios.bus_width);
+	sunxi_mmc_set_clk(host, &mmc->ios);
+
+	return host->ferror;
+}
+
+static int sunxi_mmc_prepare_hs_ddr_tuning(struct mmc_host *mmc,
+					   struct mmc_card *card)
+{
+	struct sunxi_mmc_host *host = mmc_priv(mmc);
+	u8 *ref, *buf;
+	int err;
+
+	if (!host->ddr52_tuning || host->sample_delay_fixed ||
+	    !host->ddr_old_timing || !host->use_new_timings)
+		return -EOPNOTSUPP;
+
+	dev_dbg(mmc_dev(mmc), "DDR52 tuning: reading the reference\n");
+
+	host->ddr_fallback = false;
+
+	if (!host->tuning_buf) {
+		host->tuning_buf = devm_kmalloc(mmc_dev(mmc),
+						2 * SUNXI_TUNING_LEN,
+						GFP_KERNEL);
+		if (!host->tuning_buf)
+			return -ENOMEM;
+	}
+	ref = host->tuning_buf;
+	buf = ref + SUNXI_TUNING_LEN;
+
+	err = sunxi_mmc_tuning_read(mmc, card, ref);
+	if (!err)
+		err = sunxi_mmc_tuning_read(mmc, card, buf);
+	if (!err && memcmp(ref, buf, SUNXI_TUNING_LEN))
+		err = -EIO;
+	if (!err && !sunxi_mmc_tuning_ref_ok(ref))
+		err = -ENODATA;
+	if (!err) {
+		dev_dbg(mmc_dev(mmc), "DDR52 tuning: reference ok\n");
+		return 0;
+	}
+
+	dev_warn(mmc_dev(mmc), "DDR52 tuning: no usable reference (%d)\n", err);
+	if (err != -ENODATA)
+		sunxi_mmc_tuning_recover(host);
+	return err;
+}
+
+/*
+ * Read the reference area up to @passes times at @delay. Returns the number
+ * of good reads, or a negative error if the controller cannot be used. The
+ * controller is reset after a failed read.
+ */
+static int sunxi_mmc_tuning_check(struct sunxi_mmc_host *host,
+				  struct mmc_card *card, u32 delay, u32 passes)
+{
+	u8 *ref = host->tuning_buf, *buf = ref + SUNXI_TUNING_LEN;
+	u32 pass;
+	int err;
+
+	err = sunxi_mmc_set_sample_delay(host, delay);
+	if (err) {
+		/* Once more after a reset, then give up */
+		err = sunxi_mmc_tuning_recover(host);
+		if (!err)
+			err = sunxi_mmc_set_sample_delay(host, delay);
+		if (err)
+			return err;
+	}
+
+	for (pass = 0; pass < passes; pass++)
+		if (sunxi_mmc_tuning_read(host->mmc, card, buf) ||
+		    memcmp(ref, buf, SUNXI_TUNING_LEN))
+			break;
+
+	if (pass < passes) {
+		err = sunxi_mmc_tuning_recover(host);
+		if (err)
+			return err;
+	}
+
+	return pass;
+}
+
+/* The delay must pass 3 reads in a row, in one of 3 attempts */
+static int sunxi_mmc_tuning_verify(struct sunxi_mmc_host *host,
+				   struct mmc_card *card, u32 delay)
+{
+	int i, ret;
+
+	for (i = 0; i < 3; i++) {
+		ret = sunxi_mmc_tuning_check(host, card, delay, 3);
+		if (ret == 3)
+			return 0;
+		if (ret < 0)
+			return ret;
+		dev_dbg(mmc_dev(host->mmc),
+			"DDR52 tuning: delay %u: verification attempt %d failed\n",
+			delay, i + 1);
+	}
+
+	return -EIO;
+}
+
+static int sunxi_mmc_execute_hs_ddr_tuning(struct mmc_host *mmc,
+					   struct mmc_card *card)
+{
+	struct sunxi_mmc_host *host = mmc_priv(mmc);
+	u32 delay, start = 0, best_start = 0, best_width = 0;
+	u64 passed = 0;
+	int ret;
+
+	if (ddr52_tuning_force_fail) {
+		dev_warn(mmc_dev(mmc),
+			 "DDR52 tuning: forced failure (test), falling back to HS\n");
+		ret = -EIO;
+		goto fail;
+	}
+
+	host->tuning = true;
+
+	/* On a re-initialisation, check the delay found before */
+	if (host->ddr52_tuned) {
+		ret = sunxi_mmc_tuning_verify(host, card, host->sample_delay);
+		if (!ret) {
+			dev_dbg(mmc_dev(mmc), "DDR52 tuning: delay %u still ok\n",
+				host->sample_delay);
+			host->tuning = false;
+			return 0;
+		}
+		dev_warn(mmc_dev(mmc),
+			 "DDR52 tuning: delay %u no longer works (%d), tuning again\n",
+			 host->sample_delay, ret);
+		host->ddr52_tuned = false;
+	}
+
+	dev_dbg(mmc_dev(mmc), "DDR52 tuning: sweeping the sample delay\n");
+
+	for (delay = 0; delay <= SDXC_CAL_DL_MASK; delay++) {
+		ret = sunxi_mmc_tuning_check(host, card, delay,
+					     SUNXI_TUNING_PASSES);
+		if (ret < 0) {
+			dev_warn(mmc_dev(mmc),
+				 "DDR52 tuning: controller error %d at delay %u\n",
+				 ret, delay);
+			goto fail;
+		}
+
+		dev_dbg(mmc_dev(mmc), "DDR52 tuning: delay %u: %d/%u reads ok\n",
+			delay, ret, SUNXI_TUNING_PASSES);
+
+		if (ret == SUNXI_TUNING_PASSES)
+			passed |= BIT_ULL(delay);
+	}
+
+	/* Widest run of passing delays, the lowest one on a tie, no wrap */
+	for (delay = 0; delay <= SDXC_CAL_DL_MASK + 1; delay++) {
+		bool ok = delay <= SDXC_CAL_DL_MASK && (passed & BIT_ULL(delay));
+		bool prev = delay && (passed & BIT_ULL(delay - 1));
+
+		if (ok && !prev)
+			start = delay;
+		if (!ok && prev && delay - start > best_width) {
+			best_start = start;
+			best_width = delay - start;
+		}
+	}
+
+	if (best_width < SUNXI_TUNING_MIN_WINDOW) {
+		dev_warn(mmc_dev(mmc),
+			 "DDR52 tuning failed (pass map %016llx)\n", passed);
+		ret = -EIO;
+		goto fail;
+	}
+
+	host->sample_delay = best_start + best_width / 2;
+
+	/*
+	 * Check the chosen delay once more. The centre of a wide window is
+	 * still the best choice if this fails, so only warn about it.
+	 */
+	ret = sunxi_mmc_tuning_verify(host, card, host->sample_delay);
+	if (ret == -EIO)
+		dev_warn(mmc_dev(mmc),
+			 "DDR52 tuning: delay %u failed verification, using it anyway\n",
+			 host->sample_delay);
+	else if (ret)
+		goto fail;
+
+	host->tuning = false;
+	host->ddr52_tuned = true;
+	dev_info(mmc_dev(mmc),
+		 "DDR52 sample window %u..%u, using %u (pass map %016llx)\n",
+		 best_start, best_start + best_width - 1, host->sample_delay,
+		 passed);
+	return 0;
+
+fail:
+	/*
+	 * The core switches the card back to HS mode. Use the default DDR52
+	 * setup until then: commands work with it, only writes may fail.
+	 */
+	host->tuning = false;
+	host->ddr_fallback = true;
+	sunxi_mmc_tuning_recover(host);
+	return ret;
+}
+
 static const struct mmc_host_ops sunxi_mmc_ops = {
 	.request	 = sunxi_mmc_request,
 	.set_ios	 = sunxi_mmc_set_ios,
@@ -1117,6 +1487,8 @@ static const struct mmc_host_ops sunxi_mmc_ops = {
 	.start_signal_voltage_switch = sunxi_mmc_volt_switch,
 	.card_hw_reset	 = sunxi_mmc_hw_reset,
 	.card_busy	 = sunxi_mmc_card_busy,
+	.prepare_hs_ddr_tuning = sunxi_mmc_prepare_hs_ddr_tuning,
+	.execute_hs_ddr_tuning = sunxi_mmc_execute_hs_ddr_tuning,
 };
 
 static const struct sunxi_mmc_clk_delay sunxi_mmc_clk_delays[] = {
@@ -1383,6 +1755,25 @@ static int sunxi_mmc_probe(struct platform_device *pdev)
 	if (ret)
 		return ret;
 
+	/* Optional board specific tweaks, all off by default */
+	host->fifo_watermark = 0x20070008;
+	of_property_read_u32(pdev->dev.of_node, "allwinner,fifo-watermark",
+			     &host->fifo_watermark);
+	host->sample_delay_fixed =
+		!of_property_read_u32(pdev->dev.of_node, "allwinner,sample-delay",
+				      &host->sample_delay);
+	if (host->sample_delay > SDXC_CAL_DL_MASK) {
+		dev_warn(&pdev->dev, "invalid sample delay %u, using 0\n",
+			 host->sample_delay);
+		host->sample_delay = 0;

# Stock eMMC boot helpers from the cc2-backup.img environment.
# WIC-only rollback seed; preserve COSMOS bootcmd, swu_mode and root selection.
boot_dsp0=sunxi_flash read 43000000 ${dsp0_partition};bootr 43000000 0 0
boot_normal=sunxi_flash read 43000000 ${boot_partition};bootm 43000000
cma=8M
console=ttyS2,115200
dsp0_partition=dsp0
earlyprintk=sunxi-uart,0x02500800
init=/sbin/init
initcall_debug=0
loglevel=8
rootfstype=squashfs
setargs_mmc=setenv  bootargs earlyprintk=${earlyprintk} clk_ignore_unused initcall_debug=${initcall_debug} console=${console} loglevel=${loglevel} root=${mmc_root}  init=${init} partitions=${partitions} cma=${cma} snum=${snum} mac_addr=${mac} wifi_mac=${wifi_mac} bt_mac=${bt_mac} specialstr=${specialstr} gpt=1
specialstr=
init_factory=false
ota_flag=true
boot_partition=bootA
root_partition=rootfsA
bootcmd_stock=run setargs_mmc boot_dsp0 boot_normal
bootcmd_=run bootcmd_stock
# Optional stock command-line fields start empty on a fresh installation.
partitions=
snum=
mac=
wifi_mac=
bt_mac=

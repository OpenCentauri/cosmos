#!/bin/sh

# If called with arguments (e.g., reboot/shutdown runlevel),
# just pass through to the real init
if [ $# -ne 0 ]; then
    exec {SBIN_INIT_NAME} "$@"
fi

echo "PREINIT: Start"

PATH=/sbin:/bin:/usr/sbin:/usr/bin
if {CREATE_MOUNT_DIRS}; then
    mount -o remount,rw /

    mkdir -p /proc
    mkdir -p /sys
    mkdir -p /run
    mkdir -p /var/run
    mkdir -p {OVERLAYFS_ETC_MOUNT_POINT}
fi

mount -t proc proc /proc
mount -t sysfs sysfs /sys

# Ensure /dev is populated with block device nodes before we attempt any
# block device mounts. The kernel auto-mounts devtmpfs but partition nodes
# for secondary partitions may not be present yet when running as PID 1.
mount -t devtmpfs devtmpfs /dev 2>/dev/null || true

# Wait up to 2 seconds for the data partition node to appear
i=0
while [ $i -lt 20 ] && [ ! -b {OVERLAYFS_ETC_DEVICE} ]; do
    sleep 0.1
    i=$((i + 1))
done
if [ ! -b {OVERLAYFS_ETC_DEVICE} ]; then
    echo "PREINIT: Timed out waiting for {OVERLAYFS_ETC_DEVICE}"
fi

[ -z "$CONSOLE" ] && CONSOLE="/dev/console"

BASE_OVERLAY_ETC_DIR={OVERLAYFS_ETC_MOUNT_POINT}/overlay-etc
UPPER_DIR=$BASE_OVERLAY_ETC_DIR/upper
WORK_DIR=$BASE_OVERLAY_ETC_DIR/work
LOWER_DIR=$BASE_OVERLAY_ETC_DIR/lower

if mount -n -t {OVERLAYFS_ETC_FSTYPE} \
    -o {OVERLAYFS_ETC_MOUNT_OPTIONS} \
    {OVERLAYFS_ETC_DEVICE} {OVERLAYFS_ETC_MOUNT_POINT}
then
    # Factory reset check — wipe overlay if trigger file exists
    if [ -f {OVERLAYFS_ETC_MOUNT_POINT}/.factory-reset ]; then
        rm -rf $UPPER_DIR
        rm -rf $WORK_DIR
        rm -f {OVERLAYFS_ETC_MOUNT_POINT}/.factory-reset
    fi

    mkdir -p $UPPER_DIR
    mkdir -p $WORK_DIR

    # init.d overlay cleanup: BEGIN
    # Remove local overlay edits to Cosmos-provided init scripts so upgrades
    # use the new image versions. This runs at EVERY boot: the image always
    # wins for scripts it ships, so edits to image-owned scripts do not
    # persist — customize via /etc/default/<name> or add a new script.
    # Init scripts that exist only in the overlay (user-created, not shipped
    # by the image) are preserved, matching previous Cosmos behavior; if an
    # update breaks one, it is the user's responsibility to fix or remove it.
    # Kernel whiteouts (char device 0:0) hiding image-owned scripts are
    # removed; Docker/OCI-style .wh.* files never occur in a live overlayfs
    # upperdir. Opaque-directory xattrs (replaced whole init.d) unsupported.
    LOWER_INITD=${{LOWER_INITD:-/etc/init.d}}
    if [ -d "$UPPER_DIR/init.d" ]; then
        for upper_entry in "$UPPER_DIR"/init.d/*; do
            [ -e "$upper_entry" ] || continue
            entry_name=${{upper_entry##*/}}

            if [ -c "$upper_entry" ]; then
                # Kernel overlayfs whiteout hiding a lower entry; resurrect
                # it if the new image ships the script again.
                if [ "$(stat -c '%t:%T' "$upper_entry" 2>/dev/null)" = "0:0" ] && \
                   [ -f "$LOWER_INITD/$entry_name" ]; then
                    rm -f "$upper_entry"
                fi
                continue
            fi

            [ -f "$upper_entry" ] || continue
            [ -f "$LOWER_INITD/$entry_name" ] || continue
            rm -f "$upper_entry"
        done
    fi
    # init.d overlay cleanup: END

    if {OVERLAYFS_ETC_EXPOSE_LOWER}; then
        mkdir -p $LOWER_DIR

        # provide read-only access to original /etc content
        mount -o bind,ro /etc $LOWER_DIR
    fi

    mount -n -t overlay \
        -o upperdir=$UPPER_DIR \
        -o lowerdir=/etc \
        -o workdir=$WORK_DIR \
        -o index=off,xino=off,redirect_dir=off,metacopy=off \
        $UPPER_DIR /etc || \
            echo "PREINIT: Mounting etc-overlay failed!"
else
    echo "PREINIT: Mounting </data> failed!"
fi

echo "PREINIT: done; starting </sbin/init>"
exec {SBIN_INIT_NAME}
